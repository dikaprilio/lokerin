# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=8080

# Neon Postgres (Singapura). Pooled untuk aplikasi, unpooled untuk migrasi.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/lokerin?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/lokerin?sslmode=verify-full

# Minimal 32 karakter acak, misalnya: openssl rand -base64 48
SESSION_SECRET=

# Origin frontend yang boleh memanggil API, dipisah koma.
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_PROVIDERS=cloudflare,deepinfra,inference-net

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=cedar
LIVE_MAX_SECONDS=300
LIVE_MAX_SESSIONS=20

# Opsional: path Chromium. Di image Playwright tidak perlu diisi.
# CHROMIUM_PATH=
